      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "sum(rate(jobq_jobs_enqueued_total[10s]))",
          "legendFormat": "enqueued/s"
